# Copy this file to .env and fill in your values before running docker-compose.
# .env is gitignored and never baked into the image.

# Required for cloud deployments
CLOUD_AUTH_USER=stealthops
CLOUD_AUTH_PASS=

# Enrichment API keys (add whichever you have)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CENSYS_API_KEY=
SPUR_API_KEY=
VIEWDNS_API_KEY=
MXTOOLBOX_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
DNSDUMPSTER_API_KEY=
DNSDB_API_KEY=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=

# Optional tuning
# CLOUD_RATE_LIMIT=60
# CACHE_PATH=/data/cache/stealthops.db
